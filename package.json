{
  "name": "burdenline",
  "version": "0.1.0",
  "private": true,
  "description": "Drill and blast planning, explosives accounting and vibration compliance for hard rock quarries",
  "type": "module",
  "engines": {
    "node": ">=20.18.0 <21"
  },
  "main": "src/index.js",
  "bin": {
    "burdenline": "bin/burdenline.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "backup": "node scripts/backup.js",
    "export-check": "node scripts/export-check.js",
    "audit": "node scripts/audit-dependencies.js",
    "api": "node scripts/export-api.js",
    "api:check": "node scripts/export-api.js --check"
  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/jwt": "9.0.3",
    "better-sqlite3": "11.8.1",
    "fastify": "5.2.1",
    "luxon": "3.5.0",
    "pino": "9.6.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@vitest/coverage-v8": "3.0.8",
    "eslint": "9.20.1",
    "prettier": "3.5.1",
    "vitest": "3.0.8"
  }
}
